# Copy to .env and fill in. .env is gitignored.

# ── Database (admin login: used only by scripts/load_rx.py) ──
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_admin_password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer            # use "require" for hosted Postgres (Neon, Supabase)

# Password for the per-territory logins (mgr_hartford, rx_national, ...).
# The app and agent only ever connect as these read-only, row-level-secured roles.
RX_ROLE_PASSWORD=generate_a_long_random_string

# ── LLM provider: google | groq | openai | ollama ──
LLM_PROVIDER=google

# Google (free tier): each model has its own daily quota, so list several;
# when one is exhausted the next answers (LangChain fallbacks).
GOOGLE_API_KEY=...
GOOGLE_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash,gemini-3.5-flash,gemini-3-flash-preview
# GOOGLE_THINKING_LEVEL=low

# Groq (free tier) - set LLM_PROVIDER=groq
# GROQ_API_KEY=...
# GROQ_MODEL=llama-3.3-70b-versatile

# Local, no API at all - set LLM_PROVIDER=ollama (used for the BIRD benchmark)
# OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_NUM_CTX=8192

# ── App ──
SESSION_QUESTION_LIMIT=25
ANONYMIZED_TELEMETRY=False
